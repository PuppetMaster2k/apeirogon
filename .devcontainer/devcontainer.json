{
  "name": "Rust + Claude Code + Codex + Herdr",
  "image": "mcr.microsoft.com/devcontainers/rust:1-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    },
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },
  "forwardPorts": [2222],
  "portsAttributes": {
    "2222": {
      "label": "SSH (Herdr)",
      "onAutoForward": "silent"
    }
  },
  "remoteEnv": {
    "PATH": "/home/vscode/.local/bin:${containerEnv:PATH}"
  },
  "mounts": [
    "source=claude-code-config,target=/home/vscode/.claude,type=volume",
    "source=codex-cli-config,target=/home/vscode/.codex,type=volume",
    "source=herdr-config,target=/home/vscode/.config/herdr,type=volume",
    "source=rust-cargo-cache,target=/usr/local/cargo/registry,type=volume",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh,target=/tmp/host-ssh,type=bind,readonly"
  ],
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "vadimcn.vscode-lldb",
        "serayuzgur.crates"
      ],
      "settings": {
        "rust-analyzer.check.command": "clippy"
      }
    }
  }
}
